# Telegram
TELEGRAM_BOT_TOKEN=PASTE_BOTFATHER_TOKEN
TELEGRAM_CHAT_ID=
TELEGRAM_GROUP_ID=
OWNER_TELEGRAM_ID=YOUR_NUMERIC_TELEGRAM_USER_ID

# YouTube channel
YOUTUBE_CHANNEL=@coodwithyogesh
YOUTUBE_CLIENT_SECRETS_FILE=/etc/secrets/client_secret.json
YOUTUBE_TOKEN_FILE=/tmp/token.json

# AI metadata (Gemini API key from Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Supabase (Free tier)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_DB_URL=PASTE_SESSION_POOLER_CONNECTION_STRING
SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=youtube-media
TELEGRAM_WEBHOOK_SECRET=SET_A_RANDOM_SECRET_32_CHARS_OR_MORE
RENDER_EXTERNAL_URL=https://YOUR-RENDER-SERVICE.onrender.com

# App
DASHBOARD_PASSWORD=SET_A_LONG_UNIQUE_PASSWORD
MANAGER_API_TOKEN=SET_ANOTHER_LONG_RANDOM_TOKEN
APP_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
MEDIA_DIR=/tmp/media
POLL_INTERVAL_SECONDS=300
AUTO_REPLY_ENABLED=false
AUTO_UPLOAD_DEFAULT=false
AUTO_UPLOAD_PRIVACY=private
TIMEZONE=Asia/Kolkata
PORT=10000
LOG_LEVEL=INFO
